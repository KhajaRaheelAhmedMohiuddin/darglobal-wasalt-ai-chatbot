# Copy this file to .env and set your OpenRouter API key:
# cp .env.example .env
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the primary or fallback free model ID (leave blank to auto-select the largest free instruct models from https://openrouter.ai/api/v1/models at startup)
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
PORT=7860
